<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="360"
        x:Class="GoTorrent.Desktop.Views.AddTorrentWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GtBackground}"
        Icon="/Assets/app-icon.ico"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="Add Torrent">

    <!-- Same custom title bar mechanism as MainWindow (see its own comment) - a modal
         dialog only needs drag-to-move and a close button, no minimize/maximize since
         CanResize="False" already rules those out. -->
    <Grid RowDefinitions="32,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
              Background="{DynamicResource GtTitleBar}"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Image Grid.Column="0" Source="/Assets/app-icon.ico" Width="14" Height="14" Margin="10,0,6,0" />
            <TextBlock Grid.Column="1" Text="Add Torrent" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource GtSubtle}" />
            <Button Grid.Column="2" Classes="caption captionClose" Click="OnCancelClick"
                    chrome:WindowDecorationProperties.ElementRole="CloseButton">
                <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16" Spacing="6">
            <TextBlock Text="Magnet link" FontWeight="Bold" />
            <TextBox Name="MagnetBox" PlaceholderText="magnet:?xt=urn:btih:..." />

            <TextBlock Text="or a .torrent file" FontWeight="Bold" Margin="0,10,0,0" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="FilePathBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="No file selected" />
                <Button Name="BrowseButton" Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseClick" />
            </Grid>

            <TextBlock Text="Category (optional)" Margin="0,10,0,0" />
            <TextBox Name="CategoryBox" />

            <TextBlock Text="Save to (optional)" Margin="0,10,0,0" />
            <TextBox Name="DownloadDirBox" PlaceholderText="Leave blank to use gottrentd's default" />

            <TextBlock Name="ErrorText" Foreground="{DynamicResource GtError}" TextWrapping="Wrap" IsVisible="False" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Name="AddButton" Content="Add" Click="OnAddClick" Classes="accent" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>

</Window>
