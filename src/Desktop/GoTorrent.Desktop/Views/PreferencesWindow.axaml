<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="440"
        x:Class="GoTorrent.Desktop.Views.PreferencesWindow"
        Width="560" Height="440" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GtBackground}"
        Icon="/Assets/app-icon.ico"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="Preferences">

    <Grid RowDefinitions="32,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
              Background="{DynamicResource GtTitleBar}"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Image Grid.Column="0" Source="/Assets/app-icon.ico" Width="14" Height="14" Margin="10,0,6,0" />
            <TextBlock Grid.Column="1" Text="Preferences" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource GtSubtle}" />
            <Button Grid.Column="2" Classes="caption captionClose" Click="OnCancelClick"
                    chrome:WindowDecorationProperties.ElementRole="CloseButton">
                <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto">
            <!-- Sections instead of one flat panel (6.5 Stage 4). Most sections beyond
                 General/Downloads/Speed have nothing real to configure yet - gottrentd's
                 control API only exposes fleet-wide bandwidth limits today, per
                 PatchSessionRequest's own doc comment on the Go side - so each of those
                 shows an honest placeholder rather than fields that would silently do
                 nothing. The shell exists now so each one unlocks into an already-built
                 home whenever Stage 5's Go-side work adds the API behind it. -->
            <TabControl Grid.Row="0" TabStripPlacement="Left" Margin="8,8,8,0">
                <TabItem Header="General">
                    <StackPanel Margin="16" Spacing="6">
                        <CheckBox Name="StartMinimizedCheckBox" Content="Start minimized to tray" />
                        <CheckBox Name="AutostartCheckBox" Content="Start with Windows" />
                        <CheckBox Name="FileAssociationCheckBox" Content="Open .torrent files and magnet links with GoTorrent" />
                        <CheckBox Name="LightThemeCheckBox" Content="Light theme" />
                        <CheckBox Name="CompactDensityCheckBox" Content="Compact row density" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Downloads">
                    <StackPanel Margin="16" Spacing="6">
                        <TextBlock Text="Recently used save locations" FontWeight="Bold" />
                        <TextBlock Text="Suggested in the Add Torrent dialog's &quot;Save to&quot; field, most recent first." Foreground="{DynamicResource GtSubtle}" TextWrapping="Wrap" />
                        <ListBox Name="RecentDirsList" Height="180" Margin="0,6,0,0" />
                        <Button Name="ClearRecentDirsButton" Content="Clear" Click="OnClearRecentDirsClick" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Connection">
                    <StackPanel Margin="16" Spacing="6">
                        <TextBlock Text="Connection" FontWeight="Bold" />
                        <TextBlock Foreground="{DynamicResource GtSubtle}" TextWrapping="Wrap"
                                   Text="gottrentd doesn't expose the listen port, UPnP/NAT-PMP port mapping, or DHT bootstrap over its control API yet - these are set via gottrentd's own config file or command-line flags when it starts." />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Speed">
                    <StackPanel Margin="16" Spacing="6">
                        <TextBlock Text="Fleet-wide limits, in KiB/s. 0 means unlimited." Foreground="{DynamicResource GtSubtle}" TextWrapping="Wrap" />

                        <TextBlock Text="Download limit" Margin="0,10,0,0" />
                        <TextBox Name="DownLimitBox" />

                        <TextBlock Text="Upload limit" Margin="0,10,0,0" />
                        <TextBox Name="UpLimitBox" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="BitTorrent">
                    <StackPanel Margin="16" Spacing="6">
                        <TextBlock Text="BitTorrent" FontWeight="Bold" />
                        <TextBlock Foreground="{DynamicResource GtSubtle}" TextWrapping="Wrap"
                                   Text="DHT, PEX, and LSD aren't independently toggleable at runtime yet - gottrentd starts each once at daemon startup, with no dynamic on/off switch in the control API today." />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Web API">
                    <StackPanel Margin="16" Spacing="6">
                        <TextBlock Text="Connected daemon" FontWeight="Bold" />
                        <TextBlock Name="ConnectedAddressText" Foreground="{DynamicResource GtSubtle}" TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Advanced">
                    <StackPanel Margin="16" Spacing="6">
                        <TextBlock Text="Advanced" FontWeight="Bold" />
                        <TextBlock Foreground="{DynamicResource GtSubtle}" TextWrapping="Wrap"
                                   Text="IP filtering, SOCKS5/HTTP proxy, and anonymous mode are all real engine features on the Go side but aren't exposed through gottrentd's control API yet - configuring them today means editing gottrentd's own config file directly." />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="1" Name="ErrorText" Foreground="{DynamicResource GtError}" TextWrapping="Wrap" IsVisible="False" Margin="16,8,16,0" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="16">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Name="SaveButton" Content="Save" Click="OnSaveClick" Classes="accent" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>

</Window>
