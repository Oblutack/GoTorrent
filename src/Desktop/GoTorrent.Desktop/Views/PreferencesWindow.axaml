<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="220"
        x:Class="GoTorrent.Desktop.Views.PreferencesWindow"
        Width="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Preferences">

    <StackPanel Margin="16" Spacing="6">
        <TextBlock Text="Bandwidth" FontWeight="Bold" />
        <TextBlock Text="Fleet-wide limits, in KiB/s. 0 means unlimited." Foreground="Gray" TextWrapping="Wrap" />

        <TextBlock Text="Download limit" Margin="0,10,0,0" />
        <TextBox Name="DownLimitBox" />

        <TextBlock Text="Upload limit" Margin="0,10,0,0" />
        <TextBox Name="UpLimitBox" />

        <TextBlock Name="ErrorText" Foreground="Red" TextWrapping="Wrap" IsVisible="False" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Content="Cancel" Click="OnCancelClick" />
            <Button Name="SaveButton" Content="Save" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </StackPanel>

</Window>
